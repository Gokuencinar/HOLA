+static NSInteger BWRHQualityScore(long long rssi) {
+    if (rssi >= 0 || rssi <= -200) return -1;
+    NSInteger score = (NSInteger)llround((double)(rssi + 100) * 2.0);
+    return MAX(0, MIN(100, score));
+}
+
+static NSString *BWRHQualityScoreDescription(long long rssi) {
+    NSInteger score = BWRHQualityScore(rssi);
+    if (score < 0) return @"";
+    return [NSString stringWithFormat:@"%ld/100 · %@", (long)score, BWRHSignalQuality(rssi)];
+}
+
+static NSString *BWRHOUIForBSSID(NSString *bssid) {
+    if (!bssid.length) return @"";
+    NSArray<NSString *> *parts = [bssid componentsSeparatedByString:@":"];
+    if (parts.count < 3) return @"";
+    return [NSString stringWithFormat:@"%@:%@:%@",
+            [parts[0] uppercaseString], [parts[1] uppercaseString], [parts[2] uppercaseString]];
+}
+
+static NSArray<NSString *> *BWRHLocalAddressesForFamily(int family) {
+    struct ifaddrs *interfaces = NULL;
+    if (getifaddrs(&interfaces) != 0 || !interfaces) return @[];
+
+    NSMutableArray<NSString *> *global = [NSMutableArray array];
+    NSMutableArray<NSString *> *linkLocal = [NSMutableArray array];
+    for (struct ifaddrs *cursor = interfaces; cursor; cursor = cursor->ifa_next) {
+        if (!cursor->ifa_addr || !cursor->ifa_name || strcmp(cursor->ifa_name, "en0") != 0) continue;
+        if (cursor->ifa_addr->sa_family != family) continue;
+
+        char buffer[INET6_ADDRSTRLEN] = {0};
+        const void *address = NULL;
+        if (family == AF_INET) address = &((struct sockaddr_in *)cursor->ifa_addr)->sin_addr;
+        else if (family == AF_INET6) address = &((struct sockaddr_in6 *)cursor->ifa_addr)->sin6_addr;
+        if (!address || !inet_ntop(family, address, buffer, sizeof(buffer))) continue;
+
+        NSString *value = [NSString stringWithUTF8String:buffer];
+        if (!value.length) continue;
+        if (family == AF_INET6 && [value.lowercaseString hasPrefix:@"fe80:"]) [linkLocal addObject:value];
+        else [global addObject:value];
+    }
+    freeifaddrs(interfaces);
+    return global.count ? global : linkLocal;
+}
+
+static NSString *BWRHLocalIPv4Address(void) {
+    return BWRHLocalAddressesForFamily(AF_INET).firstObject ?: @"";
+}
+
+static NSString *BWRHLocalIPv6Description(id config) {
+    id configured = BWRHMsgObject(config, @"ipv6Addresses");
+    if ([configured isKindOfClass:[NSArray class]] && [configured count]) {
+        NSMutableArray<NSString *> *strings = [NSMutableArray array];
+        for (id value in (NSArray *)configured) {
+            NSString *string = BWRHStringValue(value);
+            if (string.length) [strings addObject:string];
+        }
+        if (strings.count) return [strings componentsJoinedByString:@", "];
+    }
+    NSString *single = BWRHStringValue(BWRHMsgObject(config, @"ipv6Address"));
+    if (single.length) return single;
+    return [BWRHLocalAddressesForFamily(AF_INET6) componentsJoinedByString:@", "];
+}
+
+static NSString *BWRHLastScanAgeDescription(void) {
+    NSDate *date = nil;
+    @synchronized (BWRHPrefsDomain) { date = BWRHLastSnapshotDate; }
+    if (!date) return BWRHT(@"Sin datos", @"No data");
+    NSTimeInterval age = MAX(0.0, -date.timeIntervalSinceNow);
+    if (age < 2.0) return BWRHT(@"Ahora", @"Now");
+    if (age < 60.0) return [NSString stringWithFormat:@"%.0f s", age];
+    if (age < 3600.0) return [NSString stringWithFormat:@"%.0f min", floor(age / 60.0)];
+    return [NSString stringWithFormat:@"%.1f h", age / 3600.0];
+}
+
+static NSString *BWRHDiagnosticReport(id network, id config) {
+    network = BWRHResolvedCurrentNetwork(network);
+    NSMutableArray<NSString *> *lines = [NSMutableArray arrayWithObject:@"BetterWiFi RH 1.1 experimental diagnostic"];
+    void (^add)(NSString *, NSString *) = ^(NSString *label, NSString *value) {
+        if (value.length) [lines addObject:[NSString stringWithFormat:@"%@: %@", label, value]];
+    };
+
+    add(@"SSID", BWRHNetworkSSID(network));
+    NSString *bssid = BWRHBSSID(network);
+    add(@"BSSID", bssid);
+    add(@"OUI", BWRHOUIForBSSID(bssid));
+    long long rssi = BWRHNetworkRSSI(network);
+    if (rssi != LLONG_MIN) {
+        add(@"RSSI", [NSString stringWithFormat:@"%lld dBm", rssi]);
+        add(@"Quality", BWRHQualityScoreDescription(rssi));
+    }
+    add(@"Security", BWRHSecurityDescription(network));
+    NSNumber *channel = BWRHChannelNumber(network);
+    if (channel) add(@"Channel", channel.stringValue);
+    add(@"Band", BWRHBandDescription(network));
+    NSNumber *width = BWRHChannelWidth(network);
+    if (width.integerValue > 0) add(@"Channel width", [NSString stringWithFormat:@"%@ MHz", width]);
+
+    NSString *ipv4 = BWRHStringValue(BWRHMsgObject(config, @"ipv4Address"));
+    add(@"IPv4", ipv4.length ? ipv4 : BWRHLocalIPv4Address());
+    add(@"IPv6", BWRHLocalIPv6Description(config));
+    add(@"Router", BWRHStringValue(BWRHMsgObject(config, @"ipv4RouterAddress")));
+    id dns = BWRHMsgObject(config, @"dnsServerAddresses");
+    if ([dns isKindOfClass:[NSArray class]] && [dns count]) add(@"DNS", [(NSArray *)dns componentsJoinedByString:@", "]);
+    add(@"Last scan", BWRHLastScanAgeDescription());
+    [lines addObject:@"Passwords are never included."];
+    return [lines componentsJoinedByString:@"\n"];
+}
